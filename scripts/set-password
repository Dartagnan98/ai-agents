#!/bin/bash
# Set a login's password from the terminal, for when nobody can sign in to change it in Settings › Users.
# Asks twice with hidden typing; only the bcrypt hash is saved. Also clears every sign-in lockout.
# Usage, from the app folder:  npm run set-password -- [login name, default: the first login made]
set -euo pipefail
cd "$(dirname "$0")/.."
user=${1:-}
read -rsp "New password${user:+ for $user}: " p; echo
read -rsp "Same again: " q; echo
[ "$p" = "$q" ] || { echo "The two did not match. Nothing changed."; exit 1; }
[ ${#p} -ge 8 ] || { echo "Use at least 8 characters. Nothing changed."; exit 1; }
[ -f .env.local ] && { set -a; source .env.local; set +a; }
printf %s "$p" | node -e '
const fs = require("fs"), path = require("path"), bcrypt = require("bcryptjs"), Database = require("better-sqlite3");
const pw = fs.readFileSync(0, "utf8");
const root = path.resolve(process.env.CTX_ROOT || "./data");
const db = new Database(path.join(root, "dashboard", "cortextos-" + (process.env.CTX_INSTANCE_ID || "default") + ".db"));
const name = process.argv[1] || (db.prepare("SELECT username FROM users ORDER BY id LIMIT 1").get() || {}).username;
if (!name) { console.log("No owner login yet: open the app and make one first."); process.exit(1); }
const changed = db.prepare("UPDATE users SET password_hash = ? WHERE username = ?").run(bcrypt.hashSync(pw.toLowerCase(), 12), name).changes;
try { db.prepare("DELETE FROM rate_limits").run(); } catch {}
console.log(changed ? "Password set for " + name + ". Sign in with it now." : "No login named " + name + ". Nothing changed.");
' "$user"
