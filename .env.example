# Copy to .env.local (npm run setup does it for you, with a random secret).
# Signs the sign-in cookies. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string
# Where the app keeps its data (SQLite databases, uploads, agent workspace). Relative to this folder.
CTX_ROOT=./data
# The first visit makes the owner login (no seed admin).
FLEET_FIRST_RUN_SETUP=1
# The app's name in the header and tab, and its time zone (default: this computer's).
# APP_NAME=AI Agents
# APP_TZ=America/New_York
# Optional: require this token on the first-run page (useful if the app is reachable by others).
# FLEET_SETUP_TOKEN=
# The address you open the app at.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
